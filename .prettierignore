# 生成物与第三方资产不参与格式化，避免制造无意义的整文件 diff
node_modules/
package-lock.json

assets/
screenshots/

# 发布包：由 _data/pack-public.mjs 从源头复制，格式化它毫无意义
dist/

# 生成物：源头是 _data/build.mjs，改它无意义
js/data.js
# 本机态的歌词内联 payload（生成物，且不进版本库）
js/lyrics/

# 第三方字典与抓取/生成的事实数据
_data/TSCharacters.js
_data/TSPhrases.js
# OpenCC 簡→繁字典：由 _data/fetch-s2t.mjs 抓成單行序列化格式，與上面兩份同類
_data/STCharacters.js
_data/gf.css
_data/albums-raw.json
_data/colors.json
_data/artists/*/colors.json
_data/artists/*/albums-raw.json
# 逐曲署名：由 _data/extract-credits.mjs 從歌詞 sidecar 抽出，機器產生
_data/artists/*/credits.json
# place-media.mjs --report 的落盤報告：機器產生的 JSON，不經人手，
# 而且它沒有結尾換行（writeFileSync 直接寫 JSON.stringify），
# Prettier 會想補一個換行——那會讓每次跑完 fall 落盤都被判格式不合
_data/_*-report.json

# ── 刻意保留手写排版的文档层 ────────────────────────────────────────────
# css/style.css 与 index.html 采用紧凑分组写法（一行放多个相关属性），
# 是刻意的可读性选择；Prettier 会把 style.css 从 1564 行拆到 3067 行。
# 各 README / AGENTS 为中文文档，按句断行，Prettier 会重排表格填充与换行。
# 格式一致性靠 .editorconfig 与 review 保证。
# 若要全量统一：删掉下面三行，跑 npm run format 即可。
css/style.css
*.html
*.md
