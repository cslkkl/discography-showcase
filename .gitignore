# 依赖
node_modules/

# 编辑器与系统
.DS_Store
Thumbs.db
*.log

# 临时产物
*.tmp
*.bak

# 公开部署包（由 _data/pack-public.mjs 生成，可随时重建，不入库）
dist/

# 说明：assets/ 与 screenshots/ 必须入库
# README 直接引用它们，忽略会导致 GitHub 上拉不到图

# 使用者自有音档与歌词：只留在本机，绝不入库
# 版权录音与歌词文本一旦进版本库就等同于公开分发
# 两者都由 _data/local-audio.mjs 扫描 assets/audio/<专辑id>/ 生成
assets/audio/
_data/local-audio.json
_data/local-lyrics.json

# place-media.mjs 落盘时用 --report 写出的报告：内含本机绝对路径
# （例如 C:\Users\<你>\Desktop\音源\<歌手>），同属只留本机的 sidecar
_data/_*-report.json

# 外部参考副本（clone 进来的其他项目）绝不入库：
# 它们自带 .git 与 node_modules，一旦 git add . 会把上千个文件塞进本站
folia-major/
# Playwright MCP 的臨時產物
.playwright-mcp/
